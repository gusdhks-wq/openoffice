{
  "name": "@genoffice/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:add": "cap add android && node --experimental-strip-types scripts/configure-android.ts",
    "android:sync": "npm run build && cap sync android && node --experimental-strip-types scripts/configure-android.ts",
    "android:open": "cap open android",
    "prebuild": "node scripts/prepare-hwp.mjs",
    "predev": "node scripts/prepare-hwp.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@genoffice/cloud-documents": "*",
    "@genoffice/i18n": "*",
    "@genoffice/ui": "*",
    "@noble/hashes": "^2.2.0",
    "@rhwp/core": "file:../../vendor/rhwp-core",
    "@rhwp/editor": "0.8.7",
    "buffer": "^6.0.3",
    "cfb": "^1.2.2",
    "crc-32": "^1.2.2",
    "pako": "^2.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
